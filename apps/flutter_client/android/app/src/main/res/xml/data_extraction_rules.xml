<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same exclusions for cloud backup and for
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="torrents/" />
        <exclude domain="file" path="engine_state.dat" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="torrents/" />
        <exclude domain="file" path="engine_state.dat" />
    </device-transfer>
</data-extraction-rules>
